{"$schema":"https://libauth.org/schemas/wallet-template-v0.schema.json","name":"Standing Order Plus","description":"A subscription that can't charge you after you cancel, with a split payee and pause/resume: each period anyone may trigger one payment (merchant + split payee); the subscriber can pause (the rest moves to a paused covenant only they can resume or cancel), resume, or cancel at any time.","icon":"standing-order","version":"1","supported":["BCH_2026_05"],"resources":[{"name":"Original contracts","description":"contracts/standing_order_plus.scash and contracts/paused_order.scash (SolidCash), built in the BLAZE window.","url":"https://github.com/swiftbotlabs/standing-order"}],"roles":{"subscriber":{"name":"Subscriber","description":"Funds the order; pauses, resumes or cancels it with a coin of their own address.","icon":"subscriber"},"merchant":{"name":"Merchant","description":"Receives one payment per period.","icon":"merchant"},"splitPayee":{"name":"Split payee","description":"Receives a fixed share each period (co-creator, affiliate, platform fee).","icon":"merchant"},"service":{"name":"Trigger","description":"Anyone: selects the order coin and broadcasts a due payment. Needs no key; cannot redirect funds.","icon":"service"}},"start":[],"actions":{"fund":{"name":"Start a standing order","description":"Lock $(<fundSatoshis>) satoshis in the order covenant.","icon":"subscriber","roles":{"subscriber":{"requirements":{"variables":["merchantPkh","subscriberPkh","amountPerPeriod","periodBlocks","maxFee","splitPkh","splitAmount","orderId","fundSatoshis"]}}},"requirements":{"participants":[{"role":"subscriber","slots":{"min":1,"max":1}}]},"transaction":"fundTransaction"},"claim":{"name":"Pay one period","description":"Pay the merchant and the split payee one period; the rest stays in the order.","icon":"service","roles":{"service":{"requirements":{"variables":["merchantPkh","subscriberPkh","amountPerPeriod","periodBlocks","maxFee","splitPkh","splitAmount","order