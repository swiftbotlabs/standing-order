e},"splitPayee":{"relevant":false},"service":{"relevant":false}}}},"scripts":{"plusRedeemBytecode":"<orderId> <splitAmount> <splitPkh> <maxFee> <periodBlocks> <amountPerPeriod> <subscriberPkh> <merchantPkh> ","plusLockingBytecode":"OP_HASH256 <$(<plusRedeemBytecode> OP_HASH256)> OP_EQUAL","pausedRedeemBytecode":"<$(<plusRedeemBytecode> OP_HASH256)> <subscriberPkh> ","pausedLockingBytecode":"OP_HASH256 <$(<pausedRedeemBytecode> OP_HASH256)> OP_EQUAL","claimUnlockingBytecode":"<0xa443c5e4> <plusRedeemBytecode>","pauseUnlockingBytecode":"<0x2138ec0c> <plusRedeemBytecode>","cancelUnlockingBytecode":"<0x61d66248> <plusRedeemBytecode>","resumeUnlockingBytecode":"<0x2b5fb2f5> <pausedRedeemBytecode>","merchantLockingBytecode":"OP_DUP OP_HASH160 <merchantPkh> OP_EQUALVERIFY OP_CHECKSIG","splitLockingBytecode":"OP_DUP OP_HASH160 <splitPkh> OP_EQUALVERIFY OP_CHECKSIG","subscriberLockingBytecode":"OP_DUP OP_HASH160 <subscriberPkh> OP_EQUALVERIFY OP_CHECKSIG","remainingAfterPeriod":"<orderSatoshis> <amountPerPeriod> OP_SUB <splitAmount> OP_SUB <maxFee> OP_SUB","resumedSatoshis":"<pausedSatoshis> <maxFee> OP_SUB","refundSatoshis":"<orderSatoshis> <authSatoshis> OP_ADD <maxFee> OP_SUB"},"variables":{"merchantPkh":{"name":"Merchant","description":"HASH160 of the merchant's public key (20 bytes).","type":"bytes"},"subscriberPkh":{"name":"Subscriber","description":"HASH160 of the subscriber's public key (20 bytes): their own coin authorizes pause, resume and cancel.","type":"bytes"},"amountPerPeriod":{"name":"Amount per period","description":"Satoshis paid to the merchant each period.","type":"satoshis"},"periodBlocks":{"name":"Period (blocks)","description":"Blocks between payments (relative timelock, 1-65535).","type":"integer"},"maxFee":{"name":"Max fee","description":"Most satoshis a transaction may leave to miners (the paused covenant allows at most 2,000).","type":"satoshis"},"splitPkh":{"name":"Split payee","description":"HASH160 of the split payee's public key (20 bytes).","t