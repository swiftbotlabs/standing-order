pragma solidcash ^0.50.0;

/* Standing Order: a recurring payment (subscription) on Bitcoin Cash.
 *
 * The subscriber funds this contract once. After each `period` (a relative timelock on the contract
 * UTXO, in blocks) anyone may trigger `claim`, which pays the merchant exactly `amountPerPeriod` and
 * sends the rest back to this same contract, so the next claim must wait another full period.
 * The subscriber can `cancel` at any time and take back everything that is left.
 *
 * Based on the Mecenas covenant (examples/mecenas.scash), with the period check restored and the
 * final-claim rule made exact.
 */
contract StandingOrder(
    bytes20 merchant,
    bytes20 subscriber,
    int amountPerPeriod,
    int period,
    int maxFee,
    // Random per subscription: gives every order its own covenant address, so subscribing to the same plan
    // twice never makes one covenant pay twice per period. Not used by the logic.
    bytes8 orderId
) {
    // Pay one period's amount to the merchant; anyone may broadcast it (no signature needed).
    function claim() {
        // At most one claim per period: the UTXO must be at least `period` blocks old.
        require(this.age >= period);

        // Exactly one input: a claim may only ever spend this one order UTXO. (Without this, one transaction could
        // spend two UTXOs of the same covenant, satisfy both with one pair of outputs, and send the rest elsewhere.)
        require(tx.inputs.length == 1);

        // Output 0 always pays the merchant.
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(merchant));

        int currentValue = tx.inputs[this.activeInputIndex].value;
        int changeValue = currentValue - amountPerPeriod - maxFee;

        if (changeValue < amountPerPeriod + maxFee) {
            // Last claim: what is left (minus at most maxFee) goes to the merchant; the order ends.
            require(tx.outputs.length == 1);
            require(tx.outputs[0].value >= currentValue - maxFee);
        } else {
            // Regular claim: exactly one period's amount, and the change stays in this contract. Exactly two outputs,
            // so whatever is not change can only go to miners (at most maxFee), never to a third output.
            require(tx.outputs.length == 2);
            require(tx.outputs[0].value == amountPerPeriod);
            require(tx.outputs[1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
            require(tx.outputs[1].value >= changeValue);
        }
    }

    // The subscriber cancels and takes back everything that is left.
    function cancel(pubkey pk, sig s) {
        require(hash160(pk) == subscriber);
        require(checkSig(s, pk));
    }
}
