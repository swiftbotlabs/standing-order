  "source": "pragma solidcash ^0.50.0;\n\n/* Standing Order (token): a recurring payment in a fungible CashToken, e.g. a BCH stablecoin.\n *\n * The contract UTXO holds the subscription balance as fungible tokens of `category` plus a small amount\n * of BCH that pays the claim fees. After each `period` blocks anyone may trigger `claim`, which pays the\n * merchant exactly `tokensPerPeriod` tokens (with `dust` satoshis to carry them) and returns the rest\n * of the tokens to this same contract. The subscriber can `cancel` at any time.\n */\ncontract StandingOrderToken(\n    bytes20 merchant,\n    bytes20 subscriber,\n    bytes32 category,\n    int tokensPerPeriod,\n    int period,\n    int dust,\n    int maxFee,\n    // Random per subscription: gives every order its own covenant address, so subscribing to the same plan\n    // twice never makes one covenant pay twice per period. Not used by the logic.\n    bytes8 orderId\n) {\n    function claim() {\n        require(this.age >= period);\n\n        // Only the order's own token category is ever moved by a claim.\n        require(tx.inputs[this.activeInputIndex].tokenCategory == category);\n\n        // Output 0 pays the merchant in tokens of this category.\n        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(merchant));\n        require(tx.outputs[0].tokenCategory == category);\n\n        int tokensLeft = tx.inputs[this.activeInputIndex].tokenAmount;\n        int satsLeft = tx.inputs[this.activeInputIndex].value;\n\n        if (tokensLeft <= tokensPerPeriod) {\n            // Last claim: all remaining tokens go to the merchant; the order ends.\n            require(tx.outputs[0].tokenAmount == tokensLeft);\n            // ...together with the contract's BCH (minus at most maxFee), so no one else can take it.\n            require(tx.outputs[0].value >= satsLeft - maxFee);\n        } else {\n            // Regular claim: exactly one period's tokens; the rest stays in this contract.\n            require(tx.outputs[0].tokenAmount == tokensPerPeriod);\n            require(tx.outputs[0].value <= dust);\n            require(tx.outputs[1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);\n            require(tx.outputs[1].tokenCategory == category);\n            require(tx.outputs[1].tokenAmount == tokensLeft - tokensPerPeriod);\n            // The contract keeps its BCH, minus the merchant's dust and at most maxFee.\n            require(tx.outputs[1].value >= satsLeft - dust - maxFee);\n        }\n    }\n\n    function cancel(pubkey pk, sig s) {\n        require(hash160(pk) == subscriber);\n        require(checkSig(s, pk));\n    }\n}\n",
