  "source": "pragma solidcash ^0.50.0;\n\n/* Standing Order Plus: a subscription covenant with pause/resume, a split payout, top-ups and a plan change.\n *\n * Funded once by the subscriber. After each `period` blocks anyone may claim: the merchant gets `amountPerPeriod`\n * and, if `splitAmount` > 0, `splitPayee` gets `splitAmount` (a co-creator, an affiliate or a platform fee);\n * the rest returns to this covenant, so the next claim waits another full period.\n * Anything that moves the order coin restarts its clock (UTXO age), so every such move other than cancel PAYS the\n * period in progress first: the merchant can never be kept waiting by pausing, resuming or topping up.\n *  - pause():      subscriber only. Pays the current period, then moves the rest to this order's PausedOrder, which\n *                  no one can claim from and whose resume() can only send it back here (address computed on chain).\n *  - topUp():      anyone. Pays the current period and leaves the order with at least what it had.\n *  - changePlan(): merchant AND subscriber together move the balance to a new order (new price, period or split).\n *  - cancel():     subscriber only, everything back.\n * Authorization never puts a signature inside the contract: a sibling coin from the party's own P2PKH address,\n * signed over the whole transaction (sighash ALL or ALL|UTXOS), so every BCH wallet can sign it.\n */\ncontract StandingOrderPlus(\n    bytes20 merchant,\n    bytes20 subscriber,\n    int amountPerPeriod,\n    int period,\n    int maxFee,\n    bytes20 splitPayee,\n    int splitAmount,\n    // Random per subscription: every order gets its own covenant. Not used by the logic.\n    bytes8 orderId\n) {\n    // Redeem script of PausedOrder without its two constructor pushes (scripts/paused_template.mjs).\n    bytes constant PAUSED_TEMPLATE = ;\n\n    // True when input i is a coin of `owner`'s P2PKH address, signed with sighash ALL or ALL|UTXOS.\n    function signedBy(int i, bytes20 owner) internal returns (bool) {\n        bytes auth = tx.inputs[i].unlockingBytecode;\n        int n = auth.length;\n        bytes ht = auth.slice(n - 35, n - 34);\n        return tx.inputs[i].lockingBytecode == new LockingBytecodeP2PKH(owner)\n            && auth.slice(n - 34, n - 33) == 0x21\n            && (ht == 0x41 || ht == 0x61);\n    }\n\n    // Outputs 0 (and 1 with a split) pay exactly one period. Returns the index of the next output.\n    // (Internal functions run as OP_INVOKE subroutines and see only their arguments, so the terms are passed in.)\n    function paysOnePeriod(bytes20 to, int amount, bytes20 splitTo, int split, int fee) internal returns (int) {\n        require(amount > 0 && split >= 0 && fee >= 0, \"bad terms\");\n        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(to), \"output 0 pays the merchant\");\n        require(tx.outputs[0].value == amount, \"exactly one period\");\n        int next = 1;\n        if (split > 0) {\n            require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(splitTo), \"output 1 pays the split\");\n            require(tx.outputs[1].value == split, \"exactly one split\");\n            next = 2;\n        }\n        return next;\n    }\n\n    modifier onlySubscriber() {\n        require(signedBy(tx.inputs.length - 1, subscriber), \"subscriber coin must be the last input\");\n        _;\n    }\n\n    function claim() {\n        require(period >= 1 && period <= 65535, \"period out of range\");\n        require(this.age >= period, \"one claim per period\");\n        require(tx.inputs.length == 1, \"the order coin alone\");\n\n        int currentValue = tx.inputs[this.activeInputIndex].value;\n        int perPeriod = amountPerPeriod + splitAmount;\n        int changeValue = currentValue - perPeriod - maxFee;\n\n        if (changeValue < perPeriod + maxFee) {\n            // Last claim: the order ends. The split payee still gets its share when the rest covers it.\n            require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(merchant), \"output 0 pays the merchant\");\n            if (splitAmount > 0 && currentValue - maxFee >= perPeriod) {\n                require(tx.outputs.length == 2);\n                require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(splitPayee), \"output 1 pays the split\");\n                require(tx.outputs[1].value == splitAmount, \"exactly one split\");\n                require(tx.outputs[0].value >= currentValue - maxFee - splitAmount);\n            } else {\n                require(tx.outputs.length == 1);\n                require(tx.outputs[0].value >= currentValue - maxFee);\n            }\n        } else {\n            int k = paysOnePeriod(merchant, amountPerPeriod, splitPayee, splitAmount, maxFee);\n            require(tx.outputs.length == k + 1, \"no extra outputs\");\n            require(tx.outputs[k].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode, \"change stays in the order\");\n            require(tx.outputs[k].tokenCategory == 0x, \"no token may ride on the order coin\");\n            require(tx.outputs[k].value >= changeValue);\n        }\n    }\n\n    function pause() onlySubscriber {\n        require(tx.inputs.length == 2 && this.activeInputIndex == 0, \"order coin first, subscriber coin second\");\n        int changeValue = tx.inputs[0].value - amountPerPeriod - splitAmount - maxFee;\n        require(changeValue >= amountPerPeriod + splitAmount + maxFee, \"too little left to pause\");\n        int k = paysOnePeriod(merchant, amountPerPeriod, splitPayee, splitAmount, maxFee);\n        require(tx.outputs.length <= k + 2, \"period, paused order, subscriber change\");\n        bytes32 self = bytes32(tx.inputs[0].lockingBytecode.slice(2, 34));\n        bytes pausedScript = 0x20 + self + 0x14 + subscriber + PAUSED_TEMPLATE;\n        require(tx.outputs[k].lockingBytecode == new LockingBytecodeP2SH32(hash256(pausedScript)), \"must go to this order's paused covenant\");\n        require(tx.outputs[k].tokenCategory == 0x, \"no token may ride on the order coin\");\n        require(tx.outputs[k].value >= changeValue, \"balance kept\");\n        if (tx.outputs.length == k + 2) {\n            require(tx.outputs[k + 1].lockingBytecode == new LockingBytecodeP2PKH(subscriber), \"change goes to the subscriber\");\n        }\n    }\n\n    function topUp() {\n        require(this.activeInputIndex == 0, \"order coin first\");\n        int k = paysOnePeriod(merchant, amountPerPeriod, splitPayee, splitAmount, maxFee);\n        require(tx.outputs[k].lockingBytecode == tx.inputs[0].lockingBytecode, \"stays in this order\");\n        require(tx.outputs[k].tokenCategory == 0x, \"no token may ride on the order coin\");\n        require(tx.outputs[k].value >= tx.inputs[0].value, \"after paying this period the order holds at least what it had\");\n    }\n\n    function changePlan() {\n        require(tx.inputs.length == 3 && this.activeInputIndex == 0, \"order, merchant coin, subscriber coin\");\n        require(signedBy(1, merchant), \"merchant coin second\");\n        require(signedBy(2, subscriber), \"subscriber coin last\");\n        bytes lb = tx.outputs[0].lockingBytecode;\n        require(lb.length == 35 && lb == new LockingBytecodeP2SH32(bytes32(lb.slice(2, 34))), \"new order is a P2SH32 covenant\");\n        require(tx.outputs[0].value >= tx.inputs[0].value - maxFee, \"balance kept\");\n    }\n\n    function cancel() onlySubscriber {\n        require(tx.outputs.length == 1, \"single refund output\");\n        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(subscriber), \"refund goes to the subscriber\");\n    }\n}\n",
