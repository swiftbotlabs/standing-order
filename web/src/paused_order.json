  "source": "pragma solidcash ^0.50.0;\n\n/* Paused Standing Order: where a StandingOrderPlus waits while its subscriber has paused it.\n *\n * No one can claim from here. The subscriber can resume (the funds go back to the exact order covenant they came\n * from, `resumeTo` = hash256 of its redeem script) or cancel (everything back to the subscriber).\n * Pausing already paid the merchant for the period in progress, so resuming restarts the clock fairly.\n * Authorization works like StandingOrder.cancel(): a sibling coin from the subscriber's own address, signed over the\n * whole transaction, so every wallet can sign it and no signature lives inside the contract.\n */\ncontract PausedOrder(\n    bytes20 subscriber,\n    bytes32 resumeTo\n) {\n    int constant MAX_FEE = 2000;\n\n    // The LAST input is a coin from the subscriber, signed with sighash ALL or ALL|UTXOS (never SINGLE/NONE/ANYONECANPAY).\n    modifier onlySubscriber() {\n        bytes auth = tx.inputs[tx.inputs.length - 1].unlockingBytecode;\n        require(tx.inputs[tx.inputs.length - 1].lockingBytecode == new LockingBytecodeP2PKH(subscriber), \"not the subscriber\");\n        int n = auth.length;\n        require(auth.slice(n - 34, n - 33) == 0x21, \"auth input is not P2PKH\");\n        bytes ht = auth.slice(n - 35, n - 34);\n        require(ht == 0x41 || ht == 0x61, \"auth signature must cover the whole transaction\");\n        _;\n    }\n\n    // Back to the order covenant this came from; the next claim waits a full period from now.\n    function resume() onlySubscriber {\n        require(tx.inputs.length == 2, \"order coin + subscriber coin only\");\n        require(this.activeInputIndex == 0, \"order coin first\");\n        require(tx.outputs.length <= 2, \"order + subscriber change only\");\n        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2SH32(resumeTo), \"must resume to the same order\");\n        require(tx.outputs[0].tokenCategory == 0x, \"no token may ride on the order coin\");\n        require(tx.outputs[0].value >= tx.inputs[0].value - MAX_FEE, \"order balance must be kept\");\n        if (tx.outputs.length == 2) {\n            require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(subscriber), \"change goes to the subscriber\");\n        }\n    }\n\n    // Everything back to the subscriber.\n    function cancel() onlySubscriber {\n        require(tx.outputs.length == 1, \"single refund output\");\n        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(subscriber), \"refund goes to the subscriber\");\n    }\n}\n",
